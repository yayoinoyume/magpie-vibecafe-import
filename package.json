{
  "name": "magpie-vibecafe-import",
  "version": "0.1.0",
  "description": "Upload Magpie usage to vibecafe.ai / vibe-usage, per tool, off by default.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "bin": {
    "magpie-vibecafe-import": "./cli.mjs"
  },
  "files": [
    "index.mjs",
    "cli.mjs",
    "lib/",
    "scripts/",
    "assets/",
    "page/"
  ],
  "scripts": {
    "test": "node --test",
    "selftest": "node scripts/selftest.mjs",
    "build:catalog": "node scripts/build-page-catalog.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "vibe-usage",
    "vibecafe",
    "usage",
    "tokens"
  ],
  "license": "MIT",
  "dependencies": {},
  "magpie": {
    "maxConcurrency": 1,
    "icon": "./assets/icon.svg",
    "page": {
      "title": "Vibecafe Import",
      "titles": {
        "zh": "Vibecafe 导入",
        "zh-TW": "Vibecafe 匯入",
        "ja": "Vibecafe インポート",
        "de": "Vibecafe-Import"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "options": {
      "sources": {},
      "includeOthers": false,
      "autoUpload": true
    }
  }
}
